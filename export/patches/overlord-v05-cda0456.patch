diff --git a/tests/beehave_v05.gd b/tests/beehave_v05.gd
new file mode 100644
--- /dev/null
+++ b/tests/beehave_v05.gd
@@ -0,0 +1,82 @@
+# v0.5 Beehave runtime integration spike.
+# Uses the pinned runtime-minimum addon without the editor plugin.
+extends Node
+
+var checks := 0
+var fails := 0
+
+func _ready() -> void:
+	call_deferred("_run")
+
+func ok(cond: bool, label: String) -> void:
+	checks += 1
+	if cond:
+		print("PASS  " + label)
+	else:
+		fails += 1
+		print("FAIL  " + label)
+
+func _run() -> void:
+	var root := get_tree().root
+	ok(root.has_node("BeehaveGlobalMetrics"),
+		"beehave v0.5: metrics autoload exists in headless runtime")
+	ok(root.has_node("BeehaveGlobalDebugger"),
+		"beehave v0.5: debugger autoload exists without editor plugin")
+
+	var actor := Node.new()
+	actor.name = "BeehaveProbeActor"
+	add_child(actor)
+
+	var tree := OverlordBeehaveTree.new()
+	tree.name = "ProbeTree"
+	tree.process_thread = BeehaveTree.ProcessThread.MANUAL
+	tree.enabled = true
+	tree.custom_monitor = true
+	tree.actor = actor
+
+	var sequence := SequenceComposite.new()
+	sequence.name = "ProbeSequence"
+	sequence.add_child(BeehaveNode.new())
+	sequence.add_child(BeehaveNode.new())
+	tree.add_child(sequence)
+	add_child(tree)
+	await get_tree().process_frame
+
+	ok(tree.actor == actor,
+		"beehave v0.5: tree binds to explicit OVERLORD actor")
+	ok(tree.process_thread == BeehaveTree.ProcessThread.MANUAL,
+		"beehave v0.5: manual tick mode is available for deterministic AI tests")
+
+	tree.blackboard.set_value("squad_intent", "advance")
+	ok(str(tree.blackboard.get_value("squad_intent", "")) == "advance",
+		"beehave v0.5: blackboard stores squad intent")
+	ok(sequence.get_child_count() == 2,
+		"beehave v0.5: composite owns reusable behavior children")
+
+	var result := tree.tick()
+	ok(result == BeehaveNode.SUCCESS,
+		"beehave v0.5: manual tree tick resolves deterministic success")
+	ok(tree.get_running_action() == null,
+		"beehave v0.5: completed tree leaves no stale running action")
+
+	var metrics = root.get_node("BeehaveGlobalMetrics")
+	ok(int(metrics._tree_count) >= 1,
+		"beehave v0.5: runtime performance registry sees the tree")
+	var debugger = root.get_node("BeehaveGlobalDebugger")
+	ok(debugger._registered_trees.has(tree.get_instance_id()),
+		"beehave v0.5: runtime debugger registry sees the tree")
+
+	var tree_id := tree.get_instance_id()
+	tree.queue_free()
+	actor.queue_free()
+	await get_tree().process_frame
+	await get_tree().process_frame
+
+	ok(not debugger._registered_trees.has(tree_id),
+		"beehave v0.5: OVERLORD lifecycle adapter clears stale debugger tree IDs")
+	ok(int(metrics._tree_count) == 0,
+		"beehave v0.5: tree teardown clears performance registry")
+
+	print("---")
+	print("BEEHAVE_V05 CHECKS=%d FAILS=%d" % [checks, fails])
+	get_tree().quit(1 if fails > 0 else 0)
