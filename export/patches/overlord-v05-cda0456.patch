@@ -0,0 +1,51 @@
+# CampaignAssault — pure helper for the third canonical conflict scale.
+extends RefCounted
+class_name CampaignAssault
+
+static func is_campaign(recipe: Dictionary) -> bool:
+	return bool(recipe.get("campaign", false))
+
+static func regular_count(recipe: Dictionary) -> int:
+	return maxi(0, int(recipe.get("campaign_regulars", 0)))
+
+static func state_is_campaign(state: Dictionary) -> bool:
+	var recipe: Dictionary = state.get("recipe", {})
+	return is_campaign(recipe)
+
+static func total_attacker_count(recipe: Dictionary) -> int:
+	if not is_campaign(recipe):
+		return int(recipe.get("roles", []).size())
+	return regular_count(recipe) + 1 + int(recipe.get("roles", []).size())
+
+static func force_def(recipe: Dictionary) -> Dictionary:
+	var force_id := str(recipe.get("campaign_force", ""))
+	if force_id == "" or not Defs.CAMPAIGN_FORCES.has(force_id):
+		return {}
+	return Defs.CAMPAIGN_FORCES[force_id].duplicate(true)
+
+static func archetype_for(index: int) -> String:
+	var roles := ["shield", "spearman", "archer"]
+	return roles[posmod(index, roles.size())]
+
+static func spawn_offset(index: int) -> Vector3:
+	var col := index % 5
+	var row := int(index / 5)
+	return Vector3(float(col - 2) * 2.0, 0.6, -3.0 + float(row) * 3.0)
+
+static func captain_offset() -> Vector3:
+	return Vector3(0, 0.6, 3.0)
+
+static func regular_force_summary(attackers: Array) -> Dictionary:
+	var launched := attackers.size()
+	var survivors := 0
+	for actor in attackers:
+		if actor == null or not is_instance_valid(actor):
+			continue
+		if actor is Grunt and not (actor as Grunt).dead:
+			survivors += 1
+	return {
+		"launched": launched,
+		"survivors": survivors,
+		"slain": maxi(0, launched - survivors),
+		"routed": survivors,
+	}
