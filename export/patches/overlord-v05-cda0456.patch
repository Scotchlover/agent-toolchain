+	ok(alarm != null and alarm.data.size() > 0,
+		"drama: incoming-expedition horn is generated without binary assets")
+	ok(breach != null and breach.data.size() > 0,
+		"drama: room-breach impact cue is generated without binary assets")
diff --git a/tests/navigation_v05.gd b/tests/navigation_v05.gd
new file mode 100644
--- /dev/null
+++ b/tests/navigation_v05.gd
@@ -0,0 +1,104 @@
+# v0.5 NavigationAgent3D runtime spike.
+# Proves local path-following ownership independently of RoomGraph/Hero/Minion AI.
+extends Node3D
+
+var checks := 0
+var fails := 0
+var actor: CharacterBody3D
+var driver: NavAgentDriver
+
+func _ready() -> void:
+	call_deferred("_run")
+
+func ok(cond: bool, label: String) -> void:
+	checks += 1
+	if cond:
+		print("PASS  " + label)
+	else:
+		fails += 1
+		print("FAIL  " + label)
+
+func _run() -> void:
+	var nav_mesh := NavigationMesh.new()
+	nav_mesh.vertices = PackedVector3Array([
+		Vector3(-8.0, 0.0, 8.0),
+		Vector3(8.0, 0.0, 8.0),
+		Vector3(8.0, 0.0, -8.0),
+		Vector3(-8.0, 0.0, -8.0),
+	])
+	nav_mesh.add_polygon(PackedInt32Array([0, 1, 2, 3]))
+	var region := NavigationRegion3D.new()
+	region.navigation_mesh = nav_mesh
+	add_child(region)
+
+	actor = CharacterBody3D.new()
+	actor.position = Vector3(-5.0, 0.0, 5.0)
+	add_child(actor)
+	driver = NavAgentDriver.new()
+	actor.add_child(driver)
+	driver.configure(0.45, 4.0, false)
+
+	ok(absf(driver.radius - 0.45) < 0.001,
+		"navigation v0.5: driver owns authored agent radius")
+	ok(not driver.avoidance_enabled,
+		"navigation v0.5: avoidance is opt-in rather than globally forced")
+
+	var nav_pick := Minion.choose_local_velocity(
+		Vector3(2, 0, 0), Vector3(0, 0, 2), 5.0, 0.7)
+	ok(nav_pick.is_equal_approx(Vector3(2, 0, 0)),
+		"navigation v0.5: Minion travel prefers live NavigationAgent velocity")
+	var fallback_pick := Minion.choose_local_velocity(
+		Vector3.ZERO, Vector3(0, 0, 2), 5.0, 0.7)
+	ok(fallback_pick.is_equal_approx(Vector3(0, 0, 2)),
+		"navigation v0.5: Minion travel falls back when no nav path is usable")
+	var arrival_pick := Minion.choose_local_velocity(
+		Vector3(2, 0, 0), Vector3(0, 0, 2), 0.5, 0.7)
+	ok(arrival_pick.length_squared() < 0.0001,
+		"navigation v0.5: arrival tolerance prevents path-point jitter")
+	ok(Minion.NAV_GOAL_UPDATE_INTERVAL >= 0.25,
+		"navigation v0.5: moving formation goals are throttled instead of repathed every frame")
+
+	var sync_frames := 0
+	while not driver.navigation_ready() and sync_frames < 30:
+		sync_frames += 1
+		await get_tree().physics_frame
+	ok(driver.navigation_ready(),
+		"navigation v0.5: synthetic NavigationRegion synchronizes with map")
+
+	var goal := Vector3(5.0, 0.0, -5.0)
+	driver.set_goal(goal)
+	ok(driver.target_position.distance_to(goal) < 0.001,
+		"navigation v0.5: semantic goal becomes NavigationAgent target")
+
+	var saw_path_velocity := false
+	var max_stuck := 0.0
+	var elapsed := 0.0
+	for i in range(360):
+		await get_tree().physics_frame
+		var desired := driver.desired_velocity(actor.global_position, 4.0)
+		if desired.length() > 0.1:
+			saw_path_velocity = true
+		actor.velocity = driver.submit_avoidance_velocity(desired)
+		actor.move_and_slide()
+		max_stuck = maxf(max_stuck,
+			driver.sample_stuck(actor.global_position, desired.length(), 1.0 / 60.0))
+		elapsed += 1.0 / 60.0
+		if actor.global_position.distance_to(goal) <= driver.target_desired_distance + 0.15:
+			break
+
+	ok(saw_path_velocity,
+		"navigation v0.5: get_next_path_position produces usable movement intent")
+	ok(actor.global_position.distance_to(goal) <= driver.target_desired_distance + 0.15,
+		"navigation v0.5: actor reaches target through NavigationAgent path following")
+	ok(max_stuck < 1.0,
+		"navigation v0.5: unobstructed path never trips one-second stuck threshold")
+
+	await get_tree().physics_frame
+	# Query once after arrival so the agent can advance its final internal path state.
+	driver.desired_velocity(actor.global_position, 4.0)
+	ok(driver.is_navigation_finished() or actor.global_position.distance_to(goal) <= driver.target_desired_distance,
+		"navigation v0.5: path terminates without backtracking loop")
+
+	print("---")
+	print("NAVIGATION_V05 CHECKS=%d FAILS=%d" % [checks, fails])
+	get_tree().quit(1 if fails > 0 else 0)
