+# v0.4 pre-playtest hardening integration.
+# Exercises upgrade policy, physical manifestations and Horde growth without user:// I/O.
+extends SceneTree
+
+var checks := 0
+var fails := 0
+var main: Node3D = null
+var _exit_code := 0
+
+func _initialize() -> void:
+	call_deferred("_run")
+
+func ok(cond: bool, label: String) -> void:
+	checks += 1
+	if cond:
+		print("PASS  " + label)
+	else:
+		fails += 1
+		print("FAIL  " + label)
+
+func _run() -> void:
+	Safe.gs().new_game(951)
+	Safe.gs().world.gold = 500
+	var packed: PackedScene = load("res://game/main.tscn")
+	main = packed.instantiate()
+	get_root().add_child(main)
+	await process_frame
+
+	var initial_horde: int = main.horde.total_alive()
+	ok(initial_horde == 14,
+		"preplaytest: baseline full muster remains 14 before War Banner")
+
+	var gold_before_banner: int = Safe.gs().world.gold
+	var banner_purchase: Dictionary = DomainUpgradeRules.purchase(
+		Safe.gs().world, Safe.gs().domain, "war_banner", false)
+	ok(not banner_purchase.is_empty() and Safe.gs().domain.upgrades.has("war_banner"),
+		"preplaytest: War Banner purchase installs persistent upgrade")
+	ok(Safe.gs().world.gold == gold_before_banner - int(Defs.UPGRADES["war_banner"]["cost"]),
+		"preplaytest: War Banner charges its authored cost exactly once")
+	ok(main.horde.total_alive() == initial_horde,
+		"preplaytest: buying War Banner does not resurrect/remuster current Horde")
+	main.fortress.apply_persistent_upgrades()
+	ok(main.fortress.war_banner_visual != null and main.fortress.war_banner_visual.visible,
+		"preplaytest: War Banner has a physical fortress manifestation")
+
+	var gold_after_banner: int = Safe.gs().world.gold
+	var duplicate_banner: Dictionary = DomainUpgradeRules.purchase(
+		Safe.gs().world, Safe.gs().domain, "war_banner", false)
+	ok(duplicate_banner.is_empty() and Safe.gs().world.gold == gold_after_banner,
+		"preplaytest: duplicate upgrade purchase cannot charge twice")
+
+	main.horde.remuster(main)
+	await process_frame
+	ok(main.horde.total_alive() == 18 and Safe.gs().minions_alive == 18,
+		"preplaytest: next full War Banner muster is exactly 18 physical minions")
+	main._update_power()
+	ok(Safe.gs().world.power == 10 + 18 * 2 + Safe.gs().domain.upgrade_count() * 15,
+		"preplaytest: strategic Power reflects expanded physical Horde")
+
+	var blocked_gold: int = Safe.gs().world.gold
+	var blocked_gate: Dictionary = DomainUpgradeRules.purchase(
+		Safe.gs().world, Safe.gs().domain, "gate_reinforcement", true)
+	ok(blocked_gate.is_empty() and not Safe.gs().domain.upgrades.has("gate_reinforcement")
+			and Safe.gs().world.gold == blocked_gold,
+		"preplaytest: War Table purchases are blocked during physical conflict")
+
+	var gate_purchase: Dictionary = DomainUpgradeRules.purchase(
+		Safe.gs().world, Safe.gs().domain, "gate_reinforcement", false)
+	ok(not gate_purchase.is_empty() and Safe.gs().domain.upgrades.has("gate_reinforcement")
+			and Safe.gs().world.gold == blocked_gold - int(Defs.UPGRADES["gate_reinforcement"]["cost"]),
+		"preplaytest: Reinforced Gate purchases normally after conflict")
+	main.fortress.apply_persistent_upgrades()
+	var gate: Dictionary = main.fortress.interactables["gate_portcullis"]
+	var gate_mat: StandardMaterial3D = gate["bar_mat"]
+	ok(gate_mat.metallic >= 0.85,
+		"preplaytest: Reinforced Gate restores a physical fortified visual state")
+
+	var before_bell: int = Safe.gs().world.gold
+	var bell_purchase: Dictionary = DomainUpgradeRules.purchase(
+		Safe.gs().world, Safe.gs().domain, "soul_bell", false)
+	ok(not bell_purchase.is_empty() and Safe.gs().domain.upgrades.has("soul_bell")
+			and Safe.gs().world.gold == before_bell - int(Defs.UPGRADES["soul_bell"]["cost"]),
+		"preplaytest: Soul Bell uses the same generic purchase policy")
+	main.fortress.apply_persistent_upgrades()
+	ok(main.fortress.soul_bell_visual != null and main.fortress.soul_bell_visual.visible,
+		"preplaytest: Soul Bell purchase is physically visible")
+
+	var after_bell: int = Safe.gs().world.gold
+	var duplicate_bell: Dictionary = DomainUpgradeRules.purchase(
+		Safe.gs().world, Safe.gs().domain, "soul_bell", false)
+	ok(duplicate_bell.is_empty() and Safe.gs().world.gold == after_bell,
+		"preplaytest: duplicate Soul Bell purchase is idempotent")
+
+	print("---")
+	print("PREPLAYTEST_V04 CHECKS=%d FAILS=%d" % [checks, fails])
+	var code: int = 1 if fails > 0 else 0
+	if main != null and is_instance_valid(main):
+		main.shutdown_sfx()
+		main.queue_free()
+		main = null
+	_exit_code = code
+	call_deferred("_quit_after_audio_release")
+
+func _quit_after_audio_release() -> void:
+	await process_frame
+	await process_frame
+	await create_timer(1.0).timeout
+	Sfx.clear_cache()
+	quit(_exit_code)
