@@ -0,0 +1,66 @@
+# v0.4 physical campaign-scale integration contract.
+extends SceneTree
+
+var checks := 0
+var fails := 0
+var main: Node3D = null
+var _exit_code := 0
+
+func _initialize() -> void:
+	call_deferred("_run")
+
+func ok(cond: bool, label: String) -> void:
+	checks += 1
+	if cond:
+		print("PASS  " + label)
+	else:
+		fails += 1
+		print("FAIL  " + label)
+
+func _run() -> void:
+	Safe.gs().new_game(904)
+	var packed: PackedScene = load("res://game/main.tscn")
+	main = packed.instantiate()
+	get_root().add_child(main)
+	await process_frame
+	var recipe := Expedition.make_recipe(Safe.gs().world, Safe.gs().domain, "GRAND_CONSECRATION")
+	main._spawn_expedition(recipe)
+	await process_frame
+	ok(main.party != null and main.party.launched == 6,
+		"campaign: elite six-Hero spearhead uses the existing PartyController")
+	ok(main._campaign_attackers.size() == 11,
+		"campaign: ten regulars plus one captain form the mass pressure layer")
+	ok(main.militia_alive() == 11,
+		"campaign: regular attackers are physical targetable actors")
+	ok(CampaignAssault.total_attacker_count(recipe) == 17,
+		"campaign: total force reaches a distinct scale without stat-only inflation")
+	var intact := CampaignAssault.regular_force_summary(main._campaign_attackers)
+	ok(int(intact["launched"]) == 11 and int(intact["slain"]) == 0,
+		"campaign: AAR sees the intact regular host separately from six Heroes")
+	var first_regular: Grunt = main._campaign_attackers[0]
+	first_regular.take_damage(9999.0, main.sovereign)
+	await process_frame
+	var battered := CampaignAssault.regular_force_summary(main._campaign_attackers)
+	ok(int(battered["slain"]) == 1 and int(battered["survivors"]) == 10,
+		"campaign: regular casualty ledger records physical losses before rout")
+	main._on_party_resolved({"outcome": "test", "escaped_roles": [],
+		"used_sally": false, "saw_trap": "", "relic_stolen": false})
+	await process_frame
+	ok(main._campaign_attackers.is_empty() and main.militia_alive() == 0,
+		"campaign: resolution removes the regular pressure layer cleanly")
+	print("---")
+	print("CAMPAIGN_V04 CHECKS=%d FAILS=%d" % [checks, fails])
+	var code := 1 if fails > 0 else 0
+	if main != null and is_instance_valid(main):
+		main.shutdown_sfx()
+		main.queue_free()
+		main = null
+	_exit_code = code
+	call_deferred("_quit_after_audio_release")
+
+func _quit_after_audio_release() -> void:
+	await process_frame
+	await process_frame
+	await create_timer(1.0).timeout
+	Sfx.clear_cache()
+	quit(_exit_code)
