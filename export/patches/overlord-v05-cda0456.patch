diff --git a/tools/validate_v05_playtest_telemetry.ps1 b/tools/validate_v05_playtest_telemetry.ps1
new file mode 100644
--- /dev/null
+++ b/tools/validate_v05_playtest_telemetry.ps1
@@ -0,0 +1,143 @@
+param(
+    [string]$GodotExe = "godot",
+    [string]$ProjectRoot = (Resolve-Path (Join-Path $PSScriptRoot "..")).Path,
+    [switch]$FreshImport
+)
+
+Set-StrictMode -Version Latest
+$ErrorActionPreference = "Stop"
+
+$projectFile = Join-Path $ProjectRoot "project.godot"
+if (-not (Test-Path $projectFile)) {
+    throw "project.godot not found under $ProjectRoot"
+}
+
+$evidenceDir = Join-Path $ProjectRoot "evidence\v0.5-playtest-telemetry"
+New-Item -ItemType Directory -Force -Path $evidenceDir | Out-Null
+
+function Invoke-GodotGate {
+    param(
+        [string]$Name,
+        [string[]]$Arguments,
+        [string]$Expected = ""
+    )
+    $logPath = Join-Path $evidenceDir ($Name + ".log")
+    Write-Host "== $Name =="
+    $output = & $GodotExe @Arguments 2>&1
+    $exitCode = $LASTEXITCODE
+    $output | Tee-Object -FilePath $logPath | Out-Host
+    $text = ($output | Out-String)
+
+    $scriptErrors = ([regex]::Matches($text, "(?m)^SCRIPT ERROR:")).Count
+    $errors = ([regex]::Matches($text, "(?m)^ERROR:")).Count
+    $objectLeaks = ([regex]::Matches($text, "ObjectDB instances were leaked")).Count
+    $resourceLeaks = ([regex]::Matches($text, "(?i)resources still in use at exit")).Count
+
+    if ($exitCode -ne 0) {
+        throw "$Name failed with exit code $exitCode"
+    }
+    if ($scriptErrors -ne 0 -or $errors -ne 0) {
+        throw "$Name strict scan failed: SCRIPT ERROR=$scriptErrors ERROR=$errors"
+    }
+    if ($objectLeaks -ne 0 -or $resourceLeaks -ne 0) {
+        throw "$Name lifecycle scan failed: ObjectDB=$objectLeaks ResourceLeaks=$resourceLeaks"
+    }
+    if ($Expected -ne "" -and $text -notmatch [regex]::Escape($Expected)) {
+        throw "$Name did not contain expected marker: $Expected"
+    }
+    return $logPath
+}
+
+Push-Location $ProjectRoot
+try {
+    if ($FreshImport) {
+        $cache = Join-Path $ProjectRoot ".godot"
+        if (Test-Path $cache) {
+            Remove-Item -Recurse -Force $cache
+        }
+    }
+
+    Invoke-GodotGate "fresh-import" @("--headless", "--editor", "--path", ".", "--import", "--quit-after", "2")
+
+    Invoke-GodotGate "compile-game" @(
+        "--headless", "--path", ".", "--script", "res://tests/compile_all.gd"
+    ) "COMPILE_GAME CHECKS=39 FAILS=0"
+
+    $testScripts = Get-ChildItem (Join-Path $ProjectRoot "tests") -Filter "*.gd" | Sort-Object Name
+    foreach ($test in $testScripts) {
+        $resPath = "res://tests/" + $test.Name
+        Invoke-GodotGate ("parse-" + $test.BaseName) @(
+            "--headless", "--path", ".", "--check-only", "--script", $resPath
+        )
+    }
+    if ($testScripts.Count -ne 25) {
+        throw "Expected 25 test scripts during v0.5 live Horde flow gate, found $($testScripts.Count)"
+    }
+
+    $beehaveScripts = Get-ChildItem (Join-Path $ProjectRoot "addons\beehave") -Filter "*.gd" -Recurse | Sort-Object FullName
+    foreach ($script in $beehaveScripts) {
+        $relative = $script.FullName.Substring($ProjectRoot.Length + 1).Replace("\", "/")
+        Invoke-GodotGate ("parse-beehave-" + $script.BaseName) @(
+            "--headless", "--path", ".", "--check-only", "--script", ("res://" + $relative)
+        )
+    }
+    if ($beehaveScripts.Count -ne 12) {
+        throw "Expected 12 pinned Beehave runtime scripts, found $($beehaveScripts.Count)"
+    }
+
+    $suites = [ordered]@{
+        "test_runner.gd" = "CHECKS=42 FAILS=0"
+        "combat_intelligence_v03.gd" = "CHECKS=65 FAILS=0"
+        "combat_v03.gd" = "CHECKS=26 FAILS=0"
+        "controller_v03.gd" = "CHECKS=41 FAILS=0"
+        "depth_v03.gd" = "CHECKS=27 FAILS=0"
+        "expedition_v03.gd" = "CHECKS=10 FAILS=0"
+        "horde_synergy_v03.gd" = "CHECKS=25 FAILS=0"
+        "interception_v03.gd" = "CHECKS=15 FAILS=0"
+        "invasion_drama_v03.gd" = "CHECKS=16 FAILS=0"
+        "outdoor_combat_v03.gd" = "CHECKS=24 FAILS=0"
+        "persistence_v03.gd" = "CHECKS=35 FAILS=0"
+        "campaign_v04.gd" = "CHECKS=7 FAILS=0"
+        "preplaytest_v04.gd" = "CHECKS=14 FAILS=0"
+        "fortress_v2_contract.gd" = "CHECKS=10 FAILS=0"
+    }
+    foreach ($suite in $suites.GetEnumerator()) {
+        Invoke-GodotGate ("suite-" + [IO.Path]::GetFileNameWithoutExtension($suite.Key)) @(
+            "--headless", "--path", ".", "--script", ("res://tests/" + $suite.Key)
+        ) $suite.Value
+    }
+
+    $scenes = [ordered]@{
+        "smoke.tscn" = "CHECKS=16 FAILS=0"
+        "battle.tscn" = "CHECKS=6 FAILS=0"
+        "deep.tscn" = "CHECKS=7 FAILS=0"
+        "village_test.tscn" = "CHECKS=28 FAILS=0"
+        "controller_gym.tscn" = "CONTROLLER_GYM CHECKS=8 FAILS=0"
+        "navigation_v05.tscn" = "NAVIGATION_V05 CHECKS=12 FAILS=0"
+        "beehave_v05.tscn" = "BEEHAVE_V05 CHECKS=12 FAILS=0"
+        "fortress_v2_flow.tscn" = "FORTRESS_V2_FLOW CHECKS=9 FAILS=0"
+        "fortress_v2_horde_flow.tscn" = "FORTRESS_V2_HORDE_FLOW CHECKS=9 FAILS=0"
+    }
+    foreach ($scene in $scenes.GetEnumerator()) {
+        $name = [IO.Path]::GetFileNameWithoutExtension($scene.Key)
+        $log = Invoke-GodotGate ("scene-" + $name) @(
+            "--headless", "--path", ".", ("res://tests/" + $scene.Key)
+        ) $scene.Value
+        if ($scene.Key -eq "village_test.tscn") {
+            $villageText = Get-Content -Raw $log
+            if ($villageText -match "ObjectDB instances were leaked") {
+                throw "village_test still reports ObjectDB leaked instances"
+            }
+        }
+    }
+
+    Invoke-GodotGate "bench" @(
+        "--headless", "--path", ".", "res://tests/bench.tscn"
+    ) "BENCH frames=600"
+
+    Write-Host "V0.5 PLAYTEST TELEMETRY STRICT GATE PASS"
+    Write-Host "Evidence: $evidenceDir"
+}
+finally {
+    Pop-Location
+}
