+++ b/game/outdoor/site_rules.gd
@@ -0,0 +1,58 @@
+# SiteRules — authored outdoor-location pressure without a new AI framework.
+extends RefCounted
+class_name SiteRules
+
+const CONSECRATED_RADIUS := 11.0
+const CONSECRATED_DRAIN := 4.0
+const ROYAL_STANDARD_DAMAGE_MULT := 0.88
+
+static func defender_damage_taken_multiplier(site_special: String, captain_nearby: bool) -> float:
+	if site_special == "royal_standard" and captain_nearby:
+		return ROYAL_STANDARD_DAMAGE_MULT
+	return 1.0
+
+static func dominion_drain_per_second(site_special: String, captain_alive: bool,
+		distance_to_focus: float, radius: float = CONSECRATED_RADIUS) -> float:
+	if site_special == "consecrated_ground" and captain_alive and distance_to_focus <= radius:
+		return CONSECRATED_DRAIN
+	return 0.0
+
+static func layout_issues(site: Dictionary) -> Array:
+	var issues: Array = []
+	var half := float(site.get("fence_half", 0.0))
+	if half <= 0.0:
+		issues.append("missing_fence")
+		return issues
+	var seen := {}
+	for raw_spawn in site.get("spawns", []):
+		if not (raw_spawn is Array):
+			issues.append("bad_spawn")
+			continue
+		var spawn: Array = raw_spawn
+		if spawn.size() < 2:
+			issues.append("bad_spawn")
+			continue
+		var x := float(spawn[0])
+		var z := float(spawn[1])
+		var key := "%.2f:%.2f" % [x, z]
+		if seen.has(key):
+			issues.append("duplicate_spawn")
+		seen[key] = true
+		if absf(x) >= half or absf(z) >= half:
+			issues.append("spawn_outside_fence")
+	var raw_captain: Variant = site.get("captain_spawn", [])
+	if not (raw_captain is Array):
+		issues.append("bad_captain_spawn")
+	else:
+		var captain: Array = raw_captain
+		if captain.size() < 2:
+			issues.append("bad_captain_spawn")
+			return issues
+		var cx := float(captain[0])
+		var cz := float(captain[1])
+		if absf(cx) >= half or absf(cz) >= half:
+			issues.append("captain_outside_fence")
+		var captain_key := "%.2f:%.2f" % [cx, cz]
+		if seen.has(captain_key):
+			issues.append("captain_overlaps_spawn")
+	return issues
