+# v0.5 fortress topology contract.
+extends SceneTree
+
+var checks := 0
+var fails := 0
+
+func _initialize() -> void:
+	test_connectivity()
+	test_route_variants()
+	test_opening_policy()
+	test_system_placement()
+	test_sally_policy()
+	print("---")
+	print("FORTRESS_V2 CHECKS=%d FAILS=%d" % [checks, fails])
+	quit(1 if fails > 0 else 0)
+
+func ok(cond: bool, label: String) -> void:
+	checks += 1
+	if cond:
+		print("PASS  " + label)
+	else:
+		fails += 1
+		print("FAIL  " + label)
+
+func test_connectivity() -> void:
+	var reachable := FortressV2Topology.reachable_from("outer_courtyard")
+	ok(reachable.size() == FortressV2Topology.ZONES.size(),
+		"fortress v2: every authored zone is reachable from the courtyard")
+	ok(FortressV2Topology.duplicate_link_keys().is_empty(),
+		"fortress v2: topology has no duplicate authored links")
+
+func test_route_variants() -> void:
+	ok(FortressV2Topology.ROUTE_VARIANTS.size() == 3,
+		"fortress v2: three authored macro approaches reach the throne")
+	for route in FortressV2Topology.ROUTE_VARIANTS:
+		ok(FortressV2Topology.route_is_valid(route),
+			"fortress v2: route variant is a valid physical connection chain")
+	var branch_anchors := [
+		str(FortressV2Topology.ROUTE_VARIANTS[0][3]),
+		str(FortressV2Topology.ROUTE_VARIANTS[1][3]),
+		str(FortressV2Topology.ROUTE_VARIANTS[2][3]),
+	]
+	var unique := {}
+	for anchor in branch_anchors:
+		unique[anchor] = true
+	ok(unique.size() == 3,
+		"fortress v2: left/center/right macro routes diverge into distinct functional spaces")
+
+func test_opening_policy() -> void:
+	ok(FortressV2Topology.narrow_unintentional_links().is_empty(),
+		"fortress v2: normal circulation has no opening narrower than 4 m")
+	var primary_count := 0
+	for link in FortressV2Topology.LINKS:
+		if str(link["kind"]) == "primary":
+			primary_count += 1
+	ok(primary_count >= 10,
+		"fortress v2: wide primary circulation dominates the topology")
+
+func test_system_placement() -> void:
+	var required := ["gate_controls", "war_banner", "horde_muster", "soul_bell",
+		"war_table", "prison", "gate_forge", "relic", "throne"]
+	var valid := true
+	for system_id in required:
+		if not FortressV2Topology.SYSTEM_PLACEMENT.has(system_id):
+			valid = false
+			break
+		var zone_id := str(FortressV2Topology.SYSTEM_PLACEMENT[system_id])
+		if not FortressV2Topology.ZONES.has(zone_id):
+			valid = false
+			break
+	ok(valid, "fortress v2: every major gameplay system has an authored functional space")
+
+func test_sally_policy() -> void:
+	var hidden_links := []
+	for link in FortressV2Topology.LINKS:
+		if str(link["kind"]) == "hidden_choke":
+			hidden_links.append(link)
+	ok(hidden_links.size() == 2,
+		"fortress v2: hidden sally route is explicit rather than accidental circulation")
+	var widths_ok := true
+	for link in hidden_links:
+		if float(link["width"]) > 3.2:
+			widths_ok = false
+	ok(widths_ok,
+		"fortress v2: only the hidden sally route remains intentionally narrow")
diff --git a/tests/fortress_v2_flow.gd b/tests/fortress_v2_flow.gd
new file mode 100644
--- /dev/null
+++ b/tests/fortress_v2_flow.gd
@@ -0,0 +1,154 @@
+# v0.5 Fortress v2 flow/navmesh route-capacity gate.
+extends Node3D
+
+const PROBE_COUNT := 18
+const TIMEOUT := 28.0
+
+var checks := 0
+var fails := 0
+var harness: FortressV2FlowHarness
+var probes: Array[Dictionary] = []
+var max_stuck := 0.0
+var elapsed := 0.0
+
+func _ready() -> void:
+	call_deferred("_run")
+
+func ok(cond: bool, label: String) -> void:
+	checks += 1
+	if cond:
+		print("PASS  " + label)
+	else:
+		fails += 1
+		print("FAIL  " + label)
+
+func _run() -> void:
+	harness = FortressV2FlowHarness.new()
+	add_child(harness)
+	harness.build()
+	harness.bake_navigation()
+	var sync_frames := 0
+	while not harness.navigation_ready() and sync_frames < 60:
+		sync_frames += 1
+		await get_tree().physics_frame
+
+	ok(harness.navigation_ready(),
+		"fortress v2 flow: broad floor envelope bakes a live navigation mesh")
+
+	var map := harness.nav_map()
+	var zones_on_mesh := true
+	for zone_id in FortressV2FlowHarness.ZONE_POINTS:
+		var p: Vector3 = harness.zone_point(str(zone_id))
+		var snapped := NavigationServer3D.map_get_closest_point(map, p)
+		if snapped.distance_to(p) > 1.0:
+			zones_on_mesh = false
+			break
+	ok(zones_on_mesh,
+		"fortress v2 flow: every functional zone center lands on the baked navmesh")
+
+	var primary_path := NavigationServer3D.map_get_path(
+		map,
+		harness.zone_point("outer_courtyard"),
+		harness.zone_point("throne_heart"),
+		true)
+	ok(primary_path.size() >= 3,
+		"fortress v2 flow: courtyard and throne are connected by a nontrivial path")
+
+	var hidden_path := NavigationServer3D.map_get_path(
+		map,
+		harness.zone_point("crypt"),
+		harness.zone_point("outer_courtyard"),
+		true)
+	ok(hidden_path.size() >= 3,
+		"fortress v2 flow: crypt retains a connected secondary/sally circulation path")
+
+	_spawn_probes()
+	ok(probes.size() == PROBE_COUNT,
+		"fortress v2 flow: 18 independent route probes are instantiated")
+
+	while elapsed < TIMEOUT and _finished_count() < PROBE_COUNT:
+		await get_tree().physics_frame
+		_tick_probes(1.0 / 60.0)
+		elapsed += 1.0 / 60.0
+
+	ok(_finished_count() == PROBE_COUNT,
+		"fortress v2 flow: all 18 probes reach the throne through three macro routes")
+	ok(max_stuck < 1.0,
+		"fortress v2 flow: no unobstructed probe trips the one-second stuck threshold")
+
+	var route_counts := [0, 0, 0]
+	for probe in probes:
+		if bool(probe["finished"]):
+			route_counts[int(probe["route_id"])] += 1
+	ok(route_counts == [6, 6, 6],
+		"fortress v2 flow: left/center/right macro routes each deliver six probes")
+	ok(elapsed < TIMEOUT,
+		"fortress v2 flow: route-capacity probe completes before diagnostic timeout")
+
+	print("---")
+	print("FORTRESS_V2_FLOW CHECKS=%d FAILS=%d" % [checks, fails])
+	get_tree().quit(1 if fails > 0 else 0)
+
+func _spawn_probes() -> void:
+	for i in range(PROBE_COUNT):
+		var route_id := i % 3
+		var body := CharacterBody3D.new()
+		body.name = "FlowProbe_%02d" % i
+		body.collision_layer = 0
+		body.collision_mask = Combat.MASK_WORLD
+		body.position = Vector3(
+			-4.0 + float(i % 6) * 1.6,
+			0.65,
+			46.0 - float(i / 6) * 1.2)
+		var shape := CollisionShape3D.new()
+		var cap := CapsuleShape3D.new()
+		cap.radius = 0.34
+		cap.height = 1.1
+		shape.shape = cap
+		body.add_child(shape)
+		add_child(body)
+
+		var driver := NavAgentDriver.new()
+		body.add_child(driver)
+		driver.configure(0.34, 4.8, false)
+		driver.set_goal(FortressV2FlowHarness.FLOW_ROUTES[route_id][0])
+		probes.append({
+			"body": body,
+			"driver": driver,
+			"route_id": route_id,
+			"waypoint": 0,
+			"finished": false,
+		})
+
+func _tick_probes(dt: float) -> void:
+	for probe in probes:
+		if bool(probe["finished"]):
+			continue
+		var body: CharacterBody3D = probe["body"]
+		var driver: NavAgentDriver = probe["driver"]
+		var route: Array = FortressV2FlowHarness.FLOW_ROUTES[int(probe["route_id"])]
+		var waypoint := int(probe["waypoint"])
+		var goal: Vector3 = route[waypoint]
+		if body.global_position.distance_to(goal) <= driver.target_desired_distance + 0.25:
+			waypoint += 1
+			probe["waypoint"] = waypoint
+			if waypoint >= route.size():
+				probe["finished"] = true
+				body.velocity = Vector3.ZERO
+				continue
+			driver.set_goal(route[waypoint])
+
+		var desired := driver.desired_velocity(body.global_position, 4.8)
+		body.velocity.x = desired.x
+		body.velocity.z = desired.z
+		body.velocity.y = -0.5
+		body.move_and_slide()
+		max_stuck = maxf(max_stuck,
+			driver.sample_stuck(body.global_position, desired.length(), dt))
+
+func _finished_count() -> int:
+	var count := 0
+	for probe in probes:
+		if bool(probe["finished"]):
+			count += 1
+	return count
