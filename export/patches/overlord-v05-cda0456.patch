new file mode 100644
--- /dev/null
+++ b/game/navigation/nav_agent_driver.gd
@@ -0,0 +1,73 @@
+# NavAgentDriver — v0.5 local path-following seam.
+# High-level semantic intent sets goals; this component owns NavigationAgent3D
+# path state and exposes desired/safe velocity without moving the actor itself.
+extends NavigationAgent3D
+class_name NavAgentDriver
+
+var last_safe_velocity := Vector3.ZERO
+var safe_velocity_valid := false
+var stuck_time := 0.0
+var _last_progress_position := Vector3.ZERO
+var _progress_initialized := false
+
+func configure(agent_radius: float, movement_speed: float,
+		use_avoidance: bool = false) -> void:
+	radius = maxf(0.05, agent_radius)
+	max_speed = maxf(0.1, movement_speed)
+	path_desired_distance = maxf(0.45, radius * 1.25)
+	target_desired_distance = maxf(0.55, radius * 1.5)
+	neighbor_distance = maxf(4.0, radius * 10.0)
+	max_neighbors = 8
+	avoidance_enabled = use_avoidance
+	if not velocity_computed.is_connected(_on_velocity_computed):
+		velocity_computed.connect(_on_velocity_computed)
+
+func navigation_ready() -> bool:
+	var map := get_navigation_map()
+	return map.is_valid() and NavigationServer3D.map_get_iteration_id(map) > 0
+
+func set_goal(world_position: Vector3) -> void:
+	target_position = world_position
+	safe_velocity_valid = false
+
+func desired_velocity(actor_position: Vector3, movement_speed: float) -> Vector3:
+	if not navigation_ready() or is_navigation_finished():
+		return Vector3.ZERO
+	var next := get_next_path_position()
+	var to_next := next - actor_position
+	to_next.y = 0.0
+	if to_next.length_squared() <= 0.0001:
+		return Vector3.ZERO
+	return to_next.normalized() * minf(max_speed, maxf(0.0, movement_speed))
+
+func submit_avoidance_velocity(desired: Vector3) -> Vector3:
+	if not avoidance_enabled:
+		last_safe_velocity = desired
+		safe_velocity_valid = true
+		return desired
+	velocity = desired
+	return last_safe_velocity if safe_velocity_valid else Vector3.ZERO
+
+func sample_stuck(actor_position: Vector3, requested_speed: float, dt: float,
+		progress_epsilon: float = 0.025) -> float:
+	if not _progress_initialized:
+		_last_progress_position = actor_position
+		_progress_initialized = true
+		stuck_time = 0.0
+		return stuck_time
+	var moved := actor_position.distance_to(_last_progress_position)
+	if requested_speed > 0.15 and moved < progress_epsilon:
+		stuck_time += maxf(0.0, dt)
+	else:
+		stuck_time = 0.0
+	_last_progress_position = actor_position
+	return stuck_time
+
+func reset_progress_monitor(actor_position: Vector3) -> void:
+	_last_progress_position = actor_position
+	_progress_initialized = true
+	stuck_time = 0.0
+
+func _on_velocity_computed(safe_velocity: Vector3) -> void:
+	last_safe_velocity = safe_velocity
+	safe_velocity_valid = true
