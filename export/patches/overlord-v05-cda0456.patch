@@ -0,0 +1,94 @@
+# v0.3 outdoor combat readability / fairness contracts.
+# Run: Godot --headless --path . -s res://tests/outdoor_combat_v03.gd
+extends SceneTree
+
+var checks := 0
+var fails := 0
+
+func _initialize() -> void:
+	test_role_windups()
+	test_range_and_cooldown_contracts()
+	test_spawn_phase()
+	test_site_identity()
+	print("---")
+	print("OUTDOOR_COMBAT_V03 CHECKS=%d FAILS=%d" % [checks, fails])
+	quit(1 if fails > 0 else 0)
+
+func ok(cond: bool, label: String) -> void:
+	checks += 1
+	if cond:
+		print("PASS  " + label)
+	else:
+		fails += 1
+		print("FAIL  " + label)
+
+func test_role_windups() -> void:
+	var captain: float = Grunt.attack_windup_for("captain", true)
+	var shield: float = Grunt.attack_windup_for("shield", false)
+	var spear: float = Grunt.attack_windup_for("spearman", false)
+	var archer: float = Grunt.attack_windup_for("archer", false)
+	ok(captain >= 0.30 and captain < shield,
+		"outdoor telegraph: captain is dangerous but still readable")
+	ok(shield < spear and spear < archer,
+		"outdoor telegraph: spear/archer commitments are progressively more readable")
+	ok(archer <= 0.75,
+		"outdoor telegraph: ranged windup stays responsive rather than sluggish")
+	ok(Grunt.attack_telegraph_color("archer") != Grunt.attack_telegraph_color("shield"),
+		"outdoor readability: ranged and frontline attack cues are visually distinct")
+
+func test_range_and_cooldown_contracts() -> void:
+	ok(Grunt.ATTACK_RANGE_MARGIN <= 0.15,
+		"outdoor fairness: resolved hit tolerance stays close to authored range")
+	var g := Grunt.new()
+	g.archetype = "shield"
+	var shield_range: float = g.def_range()
+	g.archetype = "spearman"
+	var spear_range: float = g.def_range()
+	g.archetype = "archer"
+	var archer_range: float = g.def_range()
+	ok(shield_range < spear_range and spear_range < archer_range,
+		"outdoor roles: shield, spear and archer retain distinct engagement ranges")
+	ok(Grunt.attack_interval(false, true) < Grunt.attack_interval(false, false),
+		"outdoor coordination: captain aura increases regular defender tempo")
+	ok(Grunt.attack_interval(true, true) >= Grunt.attack_interval(false, true),
+		"outdoor balance: captain aura does not recursively haste the captain")
+	var shield_interval: float = Grunt.attack_interval(false, false, "shield")
+	var spear_interval: float = Grunt.attack_interval(false, false, "spearman")
+	var archer_interval: float = Grunt.attack_interval(false, false, "archer")
+	ok(shield_interval < spear_interval and spear_interval < archer_interval,
+		"outdoor roles: shield pressure, spear commitment and archer cadence are distinct")
+	ok(Grunt.attack_interval(false, true, "archer") < archer_interval,
+		"outdoor coordination: captain aura accelerates every regular archetype")
