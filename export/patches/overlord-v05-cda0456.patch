+# OVERLORD lifecycle adapter for the pinned Beehave runtime.
+# Upstream BeehaveTree registers itself with BeehaveGlobalDebugger in _ready()
+# but does not remove that local registry entry in _exit_tree(). OVERLORD actors
+# are transient, so stale tree IDs are not acceptable.
+extends BeehaveTree
+class_name OverlordBeehaveTree
+
+func _exit_tree() -> void:
+	var debugger := get_tree().root.get_node_or_null("BeehaveGlobalDebugger")
