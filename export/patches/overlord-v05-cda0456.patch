@@ -0,0 +1,29 @@
+# DomainUpgradeRules — pure purchase policy for physical Domain upgrades.
+# Main owns UI/telemetry/save side effects; this helper owns only eligibility
+# and strategic-state mutation so it can be regression-tested without user:// I/O.
+extends RefCounted
+class_name DomainUpgradeRules
+
+static func can_purchase(world: WorldState, domain: DomainState, id: String,
+		physical_conflict: bool) -> bool:
+	if physical_conflict or not Defs.UPGRADES.has(id):
+		return false
+	if domain.upgrades.has(id):
+		return false
+	var upgrade: Dictionary = Defs.UPGRADES[id]
+	return world.gold >= int(upgrade["cost"])
+
+static func purchase(world: WorldState, domain: DomainState, id: String,
+		physical_conflict: bool) -> Dictionary:
+	if not can_purchase(world, domain, id, physical_conflict):
+		return {}
+	var upgrade: Dictionary = Defs.UPGRADES[id]
+	var cost := int(upgrade["cost"])
+	world.gold -= cost
+	domain.upgrades[id] = true
+	return {
+		"id": id,
+		"cost": cost,
+		"label": str(upgrade["label"]),
+		"desc": str(upgrade["desc"]),
+	}
