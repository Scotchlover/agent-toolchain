diff --git a/tests/controller_gym.gd b/tests/controller_gym.gd
new file mode 100644
--- /dev/null
+++ b/tests/controller_gym.gd
@@ -0,0 +1,127 @@
+# v0.5 controller traversal gym.
+# Real CharacterBody3D/capsule sweeps through authored openings with no doorway magnetism.
+extends Node3D
+
+const WALL_H := 3.2
+const WALL_D := 0.55
+const LANE_HALF_WIDTH := 4.5
+const RUN_TIMEOUT := 6.0
+
+var checks := 0
+var fails := 0
+var elapsed := 0.0
+var lanes: Array[Dictionary] = []
+var finished := false
+
+func _ready() -> void:
+	_build_lane("1.4m centered walk", 0.0, 1.4, 0.0, 4.4)
+	_build_lane("1.8m diagonal walk", 12.0, 1.8, 0.38, 4.4)
+	_build_lane("2.4m diagonal march", 24.0, 2.4, -0.65, 6.2)
+	_build_lane("1.8m opposite diagonal march", 36.0, 1.8, -0.38, 6.2)
+
+	ok(not Sovereign.USE_LEGACY_DOOR_ASSIST,
+		"controller gym: live movement runs without legacy doorway magnetism")
+	ok(Sovereign.BODY_RADIUS * 2.0 < 1.4,
+		"controller gym: Sovereign capsule physically fits the narrow diagnostic opening")
+	ok(Sovereign.FLOOR_SNAP_LENGTH >= 0.5,
+		"controller gym: grounded controller keeps explicit floor snap")
+	set_physics_process(true)
+
+func ok(cond: bool, label: String) -> void:
+	checks += 1
+	if cond:
+		print("PASS  " + label)
+	else:
+		fails += 1
+		print("FAIL  " + label)
+
+func _build_lane(label: String, center_x: float, opening: float,
+		start_offset: float, speed: float) -> void:
+	var half_gap := opening * 0.5
+	_make_wall_segment(center_x - LANE_HALF_WIDTH,
+		center_x - half_gap, center_x)
+	_make_wall_segment(center_x + half_gap,
+		center_x + LANE_HALF_WIDTH, center_x)
+
+	var body := CharacterBody3D.new()
+	body.name = label.replace(" ", "_")
+	body.collision_layer = Combat.MASK_SOVEREIGN
+	body.collision_mask = Combat.MASK_WORLD
+	body.floor_snap_length = Sovereign.FLOOR_SNAP_LENGTH
+	var shape := CollisionShape3D.new()
+	var capsule := CapsuleShape3D.new()
+	capsule.radius = Sovereign.BODY_RADIUS
+	capsule.height = Sovereign.BODY_HEIGHT
+	shape.shape = capsule
+	body.add_child(shape)
+	body.position = Vector3(center_x + start_offset, 1.2, 4.2)
+	add_child(body)
+
+	lanes.append({
+		"label": label,
+		"body": body,
+		"target": Vector3(center_x, 1.2, -4.2),
+		"speed": speed,
+		"done": false,
+		"start_z": body.position.z,
+	})
+
+func _make_wall_segment(from_x: float, to_x: float, lane_center: float) -> void:
+	var width := to_x - from_x
+	if width <= 0.01:
+		return
+	var body := StaticBody3D.new()
+	body.collision_layer = Combat.MASK_WORLD
+	var shape := CollisionShape3D.new()
+	var box := BoxShape3D.new()
+	box.size = Vector3(width, WALL_H, WALL_D)
+	shape.shape = box
+	body.add_child(shape)
+	body.position = Vector3((from_x + to_x) * 0.5, WALL_H * 0.5, 0.0)
+	add_child(body)
+
+func _physics_process(dt: float) -> void:
+	if finished:
+		return
+	elapsed += dt
+	var done_count := 0
+	for lane in lanes:
+		if bool(lane["done"]):
+			done_count += 1
+			continue
+		var body: CharacterBody3D = lane["body"]
+		var target: Vector3 = lane["target"]
+		var to_target := target - body.global_position
+		to_target.y = 0.0
+		var desired := to_target.normalized() * float(lane["speed"]) if to_target.length() > 0.05 else Vector3.ZERO
+		var planar := SovereignMotor.step_planar_velocity(
+			Vector3(body.velocity.x, 0.0, body.velocity.z),
+			desired, Sovereign.WALK_ACCEL, Sovereign.MOVE_DECEL, dt)
+		body.velocity.x = planar.x
+		body.velocity.z = planar.z
+		body.velocity.y = 0.0
+		body.move_and_slide()
+		if body.global_position.z <= -3.6:
+			lane["done"] = true
+			done_count += 1
+			ok(true, "controller gym: %s clears opening" % str(lane["label"]))
+
+	if done_count == lanes.size():
+		_finish()
+	elif elapsed >= RUN_TIMEOUT:
+		for lane in lanes:
+			if not bool(lane["done"]):
+				var body: CharacterBody3D = lane["body"]
+				ok(false, "controller gym: %s stalled at %s" % [
+					str(lane["label"]), str(body.global_position)])
+				lane["done"] = true
+		_finish()
+
+func _finish() -> void:
+	finished = true
+	set_physics_process(false)
+	ok(elapsed < RUN_TIMEOUT,
+		"controller gym: all opening traversals finish before timeout")
+	print("---")
+	print("CONTROLLER_GYM CHECKS=%d FAILS=%d" % [checks, fails])
+	get_tree().quit(1 if fails > 0 else 0)
