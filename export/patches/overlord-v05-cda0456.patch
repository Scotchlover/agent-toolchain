+
+	var sync_frames := 0
+	while not harness.navigation_ready() and sync_frames < 60:
+		sync_frames += 1
+		await get_tree().physics_frame
+	ok(harness.navigation_ready(),
+		"fortress v2 horde: navigation mesh is live before Minions spawn")
+	if not harness.navigation_ready():
+		_finish()
+		return
+
+	_spawn_minions()
+	ok(agents.size() == MINION_COUNT,
+		"fortress v2 horde: 18 real Minion actors are spawned")
+	ok(_all_use_real_minion_collision(),
+		"fortress v2 horde: probes retain Minion-vs-Minion physical collision")
+
+	var agent_sync := 0
+	while not _all_nav_ready() and agent_sync < 60:
+		agent_sync += 1
+		await get_tree().physics_frame
+	ok(_all_nav_ready(),
+		"fortress v2 horde: all Minion NavigationAgents synchronize to the map")
+
+	while elapsed < TIMEOUT and _finished_count() < MINION_COUNT:
+		await get_tree().physics_frame
+		_advance_route_targets()
+		_sample_crowd_state()
+		elapsed += Engine.time_scale / float(Engine.physics_ticks_per_second)
+
+	var routes := [0, 0, 0]
+	for entry in agents:
+		if bool(entry["finished"]):
+			routes[int(entry["route_id"])] += 1
+
+	ok(_finished_count() == MINION_COUNT,
+		"fortress v2 horde: all 18 live Minions reach the throne")
+	ok(routes == [6, 6, 6],
+		"fortress v2 horde: all three macro routes deliver six live Minions")
+	ok(max_stuck < 1.0,
+		"fortress v2 horde: no live Minion exceeds one-second nav stuck threshold")
+	ok(fell_count == 0,
+		"fortress v2 horde: no Minion falls out of the circulation envelope")
+	ok(elapsed < TIMEOUT,
+		"fortress v2 horde: live crowd finishes before diagnostic timeout")
+
+	print("HORDE_FLOW_METRICS elapsed=%.2f max_stuck=%.2f crowded_frames=%d min_pair=%.3f" % [
+		elapsed, max_stuck, crowded_frames, min_pair_distance])
+	_finish()
+
+func _spawn_minions() -> void:
+	var types := ["brute", "skitterer", "skeleton"]
+	for i in range(MINION_COUNT):
+		var route_id := i % 3
+		var minion := Minion.new()
+		minion.setup(types[i % types.size()], "flow_%d" % route_id, i)
+		add_child(minion)
+		minion.global_position = Vector3(
+			-4.0 + float(i % 6) * 1.6,
+			0.65,
+			46.0 - float(i / 6) * 1.25)
+		minion.assign_slot(FortressV2FlowHarness.FLOW_ROUTES[route_id][0])
+		agents.append({
+			"minion": minion,
+			"route_id": route_id,
+			"waypoint": 0,
+			"finished": false,
+		})
+
+func _all_use_real_minion_collision() -> bool:
+	for entry in agents:
+		var m: Minion = entry["minion"]
+		if (m.collision_layer & Combat.MASK_MINION) == 0:
+			return false
+		if (m.collision_mask & Combat.MASK_MINION) == 0:
+			return false
+	return true
+
+func _all_nav_ready() -> bool:
+	for entry in agents:
+		var m: Minion = entry["minion"]
+		if m.nav_driver == null or not m.nav_driver.navigation_ready():
+			return false
+	return true
+
+func _advance_route_targets() -> void:
+	for entry in agents:
+		if bool(entry["finished"]):
+			continue
+		var m: Minion = entry["minion"]
+		if not is_instance_valid(m):
+			continue
+		if m.global_position.y < -2.0:
+			fell_count += 1
+			entry["finished"] = true
+			continue
+		if m.nav_driver != null:
+			max_stuck = maxf(max_stuck, m.nav_driver.stuck_time)
+		var route: Array = FortressV2FlowHarness.FLOW_ROUTES[int(entry["route_id"])]
+		var idx := int(entry["waypoint"])
+		var goal: Vector3 = route[idx]
+		if m.global_position.distance_to(goal) <= 1.05:
+			idx += 1
+			entry["waypoint"] = idx
+			if idx >= route.size():
+				entry["finished"] = true
+				m.assign_slot(m.global_position)
+			else:
+				m.assign_slot(route[idx])
+
+func _sample_crowd_state() -> void:
+	var crowded := false
+	for i in range(agents.size()):
+		var a: Minion = agents[i]["minion"]
+		if not is_instance_valid(a):
+			continue
+		for j in range(i + 1, agents.size()):
+			var b: Minion = agents[j]["minion"]
+			if not is_instance_valid(b):
+				continue
+			var d := Vector2(
+				a.global_position.x - b.global_position.x,
+				a.global_position.z - b.global_position.z).length()
+			min_pair_distance = minf(min_pair_distance, d)
+			if d < CROWD_DISTANCE:
+				crowded = true
+	if crowded:
+		crowded_frames += 1
+
+func _finished_count() -> int:
+	var count := 0
+	for entry in agents:
+		if bool(entry["finished"]):
+			count += 1
+	return count
+
+func _finish() -> void:
+	Engine.time_scale = 1.0
+	print("---")
+	print("FORTRESS_V2_HORDE_FLOW CHECKS=%d FAILS=%d" % [checks, fails])
+	get_tree().quit(1 if fails > 0 else 0)
