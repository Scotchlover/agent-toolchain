@@ -0,0 +1,140 @@
+# FortressV2FlowHarness — isolated v0.5 circulation/navmesh proof.
+# This is deliberately NOT the final fortress authoring format. It turns the
+# authored topology into a broad floor-envelope so controller/Horde/navigation
+# route capacity can be measured before Cyclops/FuncGodot physical detailing.
+extends Node3D
+class_name FortressV2FlowHarness
+
+const FLOOR_THICKNESS := 0.45
+const AGENT_RADIUS := 0.45
+
+# [center_x, center_z, size_x, size_z]
+const FLOOR_PLATES := {
+	"outer_courtyard": [0.0, 42.0, 30.0, 18.0],
+	"gatehouse": [0.0, 29.0, 16.0, 8.0],
+	"muster_hall": [0.0, 14.0, 24.0, 22.0],
+	"horde_den": [-19.0, 9.5, 14.0, 21.0],
+	"war_room": [19.0, 9.5, 14.0, 21.0],
+	"forge": [0.0, -6.0, 24.0, 18.0],
+	"crypt": [-19.0, -10.0, 14.0, 18.0],
+	"prison_chapel": [19.0, -10.0, 14.0, 18.0],
+	"treasury": [0.0, -22.0, 24.0, 14.0],
+	"throne_heart": [0.0, -38.0, 20.0, 18.0],
+	"sally_gallery": [-33.0, 16.0, 8.0, 34.0],
+	# Physical loop connectors not represented as gameplay zones.
+	"crypt_throne_passage": [-13.0, -29.0, 6.0, 20.0],
+	"prison_throne_passage": [13.0, -29.0, 6.0, 20.0],
+	"crypt_sally_link": [-29.0, -1.0, 6.0, 6.4],
+	"sally_courtyard_link": [-22.0, 34.6, 14.0, 3.2],
+}
+
+const ZONE_POINTS := {
+	"outer_courtyard": Vector3(0, 0, 42),
+	"gatehouse": Vector3(0, 0, 29),
+	"muster_hall": Vector3(0, 0, 14),
+	"horde_den": Vector3(-19, 0, 9.5),
+	"crypt": Vector3(-19, 0, -10),
+	"war_room": Vector3(19, 0, 9.5),
+	"prison_chapel": Vector3(19, 0, -10),
+	"forge": Vector3(0, 0, -6),
+	"treasury": Vector3(0, 0, -22),
+	"throne_heart": Vector3(0, 0, -38),
+	"sally_gallery": Vector3(-33, 0, 16),
+}
+
+const FLOW_ROUTES := [
+	[
+		Vector3(0, 0, 29), Vector3(0, 0, 14),
+		Vector3(-19, 0, 9.5), Vector3(-19, 0, -10),
+		Vector3(-13, 0, -29), Vector3(0, 0, -38),
+	],
+	[
+		Vector3(0, 0, 29), Vector3(0, 0, 14),
+		Vector3(0, 0, -6), Vector3(0, 0, -22),
+		Vector3(0, 0, -38),
+	],
+	[
+		Vector3(0, 0, 29), Vector3(0, 0, 14),
+		Vector3(19, 0, 9.5), Vector3(19, 0, -10),
+		Vector3(13, 0, -29), Vector3(0, 0, -38),
+	],
+]
+
+var navigation_region: NavigationRegion3D
+var navigation_mesh: NavigationMesh
+var floor_root: Node3D
+
+func build() -> void:
+	floor_root = Node3D.new()
+	floor_root.name = "FlowFloor"
+	add_child(floor_root)
+	for plate_id in FLOOR_PLATES:
+		_add_floor_plate(str(plate_id), FLOOR_PLATES[plate_id])
+
+	navigation_region = NavigationRegion3D.new()
+	navigation_region.name = "FlowNavigationRegion"
+	navigation_mesh = NavigationMesh.new()
+	navigation_mesh.agent_radius = AGENT_RADIUS
+	navigation_mesh.agent_height = 2.5
+	navigation_mesh.agent_max_climb = 0.45
+	navigation_mesh.agent_max_slope = 45.0
+	navigation_mesh.geometry_parsed_geometry_type = NavigationMesh.PARSED_GEOMETRY_STATIC_COLLIDERS
+	navigation_mesh.geometry_collision_mask = Combat.MASK_WORLD
+	navigation_region.navigation_mesh = navigation_mesh
+	# Bake parses descendants of the region by default; move the floor envelope
+	# under it while preserving global transforms.
+	add_child(navigation_region)
+	var map := navigation_region.get_navigation_map()
+	# Godot requires baked NavigationMesh voxel size to match the NavigationMap.
+	navigation_mesh.cell_size = NavigationServer3D.map_get_cell_size(map)
+	navigation_mesh.cell_height = NavigationServer3D.map_get_cell_height(map)
+	floor_root.reparent(navigation_region, true)
+
+func bake_navigation() -> void:
+	if navigation_region == null:
+		return
+	# Synchronous bake is appropriate for this test-only harness and makes the
+	# gate deterministic. Production authoring will pre-bake the accepted mesh.
+	navigation_region.bake_navigation_mesh(false)
+
+func navigation_ready() -> bool:
+	if navigation_region == null or navigation_mesh == null:
+		return false
+	var map := navigation_region.get_navigation_map()
+	return (
+		map.is_valid()
+		and NavigationServer3D.map_get_iteration_id(map) > 0
+		and navigation_mesh.get_polygon_count() > 0
+	)
+
+func nav_map() -> RID:
+	return navigation_region.get_navigation_map() if navigation_region != null else RID()
+
+func zone_point(zone_id: String) -> Vector3:
+	return ZONE_POINTS.get(zone_id, Vector3.ZERO)
+
+func _add_floor_plate(id: String, data: Array) -> void:
+	var center := Vector3(float(data[0]), -FLOOR_THICKNESS * 0.5, float(data[1]))
+	var size := Vector3(float(data[2]), FLOOR_THICKNESS, float(data[3]))
+
+	var body := StaticBody3D.new()
+	body.name = id
+	body.collision_layer = Combat.MASK_WORLD
+	body.collision_mask = 0
+	body.position = center
+	var shape := CollisionShape3D.new()
+	var box := BoxShape3D.new()
+	box.size = size
+	shape.shape = box
+	body.add_child(shape)
+	floor_root.add_child(body)
+
+	var visual := MeshInstance3D.new()
+	var mesh := BoxMesh.new()
+	mesh.size = size
+	visual.mesh = mesh
+	var mat := StandardMaterial3D.new()
+	mat.albedo_color = Color(0.17, 0.16, 0.18) if not id.contains("passage") else Color(0.22, 0.19, 0.16)
+	mat.roughness = 1.0
+	visual.material_override = mat
+	body.add_child(visual)
