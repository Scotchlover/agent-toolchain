new file mode 100644
--- /dev/null
+++ b/game/player/sovereign_motor.gd
@@ -0,0 +1,35 @@
+# SovereignMotor — v0.5 player movement contract.
+# Stage A isolates canonical input/camera-space semantics from the legacy actor.
+extends RefCounted
+class_name SovereignMotor
+
+static func read_move_input() -> Vector2:
+	# Godot convention: negative_y=forward, positive_y=back.
+	return Input.get_vector("move_left", "move_right", "move_forward", "move_back")
+
+static func camera_relative_direction(input_vec: Vector2, cam_fwd: Vector3,
+		cam_right: Vector3) -> Vector3:
+	var fwd := Vector3(cam_fwd.x, 0.0, cam_fwd.z)
+	var right := Vector3(cam_right.x, 0.0, cam_right.z)
+	fwd = fwd.normalized() if fwd.length_squared() >= 0.0001 else Vector3(0, 0, -1)
+	right = right.normalized() if right.length_squared() >= 0.0001 else fwd.cross(Vector3.UP).normalized()
+	# W is input_vec.y == -1, therefore camera-forward is -fwd * y.
+	var out := right * input_vec.x - fwd * input_vec.y
+	return out.normalized() if out.length_squared() > 1.0 else out
+
+
+static func desired_planar_velocity(input_vec: Vector2, cam_fwd: Vector3,
+		cam_right: Vector3, speed: float) -> Vector3:
+	return camera_relative_direction(input_vec, cam_fwd, cam_right) * maxf(0.0, speed)
+
+static func step_planar_velocity(current_velocity: Vector3, desired_velocity: Vector3,
+		acceleration: float, deceleration: float, dt: float) -> Vector3:
+	var current := Vector3(current_velocity.x, 0.0, current_velocity.z)
+	var desired := Vector3(desired_velocity.x, 0.0, desired_velocity.z)
+	var changing_direction: bool = (
+		current.length_squared() > 0.0001
+		and desired.length_squared() > 0.0001
+		and current.dot(desired) < 0.0
+	)
+	var rate := deceleration if desired.length_squared() <= 0.0001 or changing_direction else acceleration
+	return current.move_toward(desired, maxf(0.0, rate) * maxf(0.0, dt))
