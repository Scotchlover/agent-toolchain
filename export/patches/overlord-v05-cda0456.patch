+# FortressV2Topology — authored topology contract for the v0.5 base rebuild.
+# This is NOT geometry generation. Physical blockout must conform to this graph.
+extends RefCounted
+class_name FortressV2Topology
+
+const ZONES := {
+	"outer_courtyard": {"tags": ["exterior", "campaign", "arrival"]},
+	"gatehouse": {"tags": ["entry", "defense", "gate_controls"]},
+	"muster_hall": {"tags": ["central", "horde", "war_banner"]},
+	"horde_den": {"tags": ["horde", "recovery"]},
+	"crypt": {"tags": ["soul_bell", "ritual"]},
+	"war_room": {"tags": ["war_table", "strategy"]},
+	"prison_chapel": {"tags": ["prison", "ritual", "hero_objective"]},
+	"forge": {"tags": ["upgrade", "gate_reinforcement"]},
+	"treasury": {"tags": ["relic", "hero_objective"]},
+	"throne_heart": {"tags": ["throne", "sovereign", "heart"]},
+	"sally_gallery": {"tags": ["hidden", "secondary_exit"]},
+}
+
+const LINKS := [
+	{"a": "outer_courtyard", "b": "gatehouse", "width": 5.5, "kind": "primary"},
+	{"a": "gatehouse", "b": "muster_hall", "width": 5.0, "kind": "primary"},
+
+	{"a": "muster_hall", "b": "horde_den", "width": 4.5, "kind": "primary"},
+	{"a": "horde_den", "b": "crypt", "width": 4.5, "kind": "primary"},
+	{"a": "crypt", "b": "treasury", "width": 4.2, "kind": "primary"},
+	{"a": "crypt", "b": "throne_heart", "width": 4.0, "kind": "secondary"},
+
+	{"a": "muster_hall", "b": "forge", "width": 5.0, "kind": "primary"},
+	{"a": "forge", "b": "treasury", "width": 5.0, "kind": "primary"},
+	{"a": "treasury", "b": "throne_heart", "width": 5.0, "kind": "primary"},
+
+	{"a": "muster_hall", "b": "war_room", "width": 4.5, "kind": "primary"},
+	{"a": "war_room", "b": "prison_chapel", "width": 4.5, "kind": "primary"},
+	{"a": "prison_chapel", "b": "treasury", "width": 4.2, "kind": "primary"},
+	{"a": "prison_chapel", "b": "throne_heart", "width": 4.0, "kind": "secondary"},
+
+	# Cross-links make the fortress a combat space with loops, not three corridors.
+	{"a": "horde_den", "b": "forge", "width": 4.0, "kind": "secondary"},
+	{"a": "war_room", "b": "forge", "width": 4.0, "kind": "secondary"},
+
+	# The only intentionally narrow route in the normal topology.
+	{"a": "crypt", "b": "sally_gallery", "width": 3.2, "kind": "hidden_choke"},
+	{"a": "sally_gallery", "b": "outer_courtyard", "width": 3.2, "kind": "hidden_choke"},
+]
+
+const SYSTEM_PLACEMENT := {
+	"gate_controls": "gatehouse",
+	"war_banner": "muster_hall",
+	"horde_muster": "horde_den",
+	"soul_bell": "crypt",
+	"war_table": "war_room",
+	"prison": "prison_chapel",
+	"gate_forge": "forge",
+	"relic": "treasury",
+	"throne": "throne_heart",
+}
+
+const ROUTE_VARIANTS := [
+	["outer_courtyard", "gatehouse", "muster_hall", "horde_den", "crypt", "throne_heart"],
+	["outer_courtyard", "gatehouse", "muster_hall", "forge", "treasury", "throne_heart"],
+	["outer_courtyard", "gatehouse", "muster_hall", "war_room", "prison_chapel", "throne_heart"],
+]
+
+static func adjacency() -> Dictionary:
+	var out := {}
+	for zone_id in ZONES:
+		out[zone_id] = []
+	for link in LINKS:
+		var a := str(link["a"])
+		var b := str(link["b"])
+		out[a].append(b)
+		out[b].append(a)
+	return out
+
+static func is_linked(a: String, b: String) -> bool:
+	for link in LINKS:
+		if (str(link["a"]) == a and str(link["b"]) == b) 				or (str(link["a"]) == b and str(link["b"]) == a):
+			return true
+	return false
+
+static func route_is_valid(route: Array) -> bool:
+	if route.size() < 2:
+		return false
+	for i in range(route.size() - 1):
+		if not is_linked(str(route[i]), str(route[i + 1])):
+			return false
+	return true
+
+static func reachable_from(start: String) -> Array:
+	if not ZONES.has(start):
+		return []
+	var graph := adjacency()
+	var queue: Array = [start]
+	var seen := {start: true}
+	while not queue.is_empty():
+		var current := str(queue.pop_front())
+		for next_zone in graph[current]:
+			if not seen.has(next_zone):
+				seen[next_zone] = true
+				queue.append(next_zone)
+	return seen.keys()
+
+static func narrow_unintentional_links(min_width: float = 4.0) -> Array:
+	var bad: Array = []
+	for link in LINKS:
+		if float(link["width"]) < min_width and str(link["kind"]) != "hidden_choke":
+			bad.append(link)
+	return bad
+
+static func duplicate_link_keys() -> Array:
+	var seen := {}
+	var duplicates: Array = []
+	for link in LINKS:
+		var pair := [str(link["a"]), str(link["b"])]
+		pair.sort()
+		var key := "%s::%s" % [pair[0], pair[1]]
+		if seen.has(key):
+			duplicates.append(key)
+		seen[key] = true
+	return duplicates
